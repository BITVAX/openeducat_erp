<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="student_attendance_form">
            <field name="name">student.attendance.form</field>
            <field name="model">student.attendance</field>
            <field name="arch" type="xml">
                <form string="Student Attendance Report">
                    <group col="4" colspan="4">
                        <field name="from_date" />
                        <field name="to_date" />
                    </group>
                    <footer>
                        <span groups="base.group_user">
                            <button
                                string="Print"
                                type="object" name="print_report" class="oe_highlight" />
                            <button special="cancel" string="Close"
                                type="object" />
                        </span>
                    </footer>
                </form>
            </field>
        </record>

        <record id="student_attendance_act" model="ir.actions.act_window">
            <field name="name">Student Attendance</field>
            <field name="res_model">student.attendance</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
        </record>
    </data>
</odoo>
