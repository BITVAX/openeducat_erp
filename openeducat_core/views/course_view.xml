<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_op_course_tree" model="ir.ui.view">
            <field name="name">op.course.tree</field>
            <field name="model">op.course</field>
            <field eval="8" name="priority" />
            <field name="arch" type="xml">
                <list string="Course">
                    <field name="name" />
                    <field name="code" />
                    <!-- <field name="section" /> <field name="evaluation_type" /> <field
                        name="parent_id" /> <field name="subject_ids" /> -->
                </list>
            </field>
        </record>
        <record id="view_op_course_form" model="ir.ui.view">
            <field name="name">op.course.form</field>
            <field name="model">op.course</field>
            <field eval="8" name="priority" />
            <field name="arch" type="xml">
                <form string="Course">
                    <header groups="openeducat_core.group_op_back_office"></header>
                    <sheet>

                        <div class="oe_title">
                            <!-- Sin el <label>: `oe_edit_only` solo se oculta bajo
                                 `o_form_readonly`, y desde v17 el formulario nace en
                                 EDICIÓN en vez de en lectura, así que en esta ficha la
                                 etiqueta pasó a verse siempre encima del título.
                                 Ojo, la clase NO está muerta: en un formulario que sí
                                 sea de solo lectura (`edit="0"`) sigue funcionando. -->
                            <h1>
                                <field name="name" placeholder="Course Name" />
                            </h1>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button"
                                icon="fa-archive">
                                <field name="active" widget="boolean_button"
                                    options="{&quot;terminology&quot;: &quot;archive&quot;}" />
                            </button>
                        </div>
                        <group name="main">
                            <group name="main1">
                                <field name="fullname" />
                                <field name="category_ids" widget="many2many_tags" />
                                <field name="code" />                                
                            </group>

                            <!-- <group name="main2"> <field name="evaluation_type" /> <field 
                                name="parent_id" /> <field name="min_unit_load" /> <field name="max_unit_load" /> </group> -->
                        </group>
                        <notebook>
                            <page name="faculties" string="Editors">
                                <group name="faculty" string="Editors">
                                    <field name="faculty_ids" nolabel="1"
                                        options="{'no_create':True}" />
                                </group>
                            </page>
                            <page name="batches" string="Batches">
                                <group name="batch" string="Batches">
                                    <field
                                        context="{'default_course_id': id}"
                                        name="batch_ids" nolabel="1" readonly="1" />
                                </group>
                            </page>
                            <page name="data" string="Data">
                                <group>
                                    <group>
                                        <field name="short_description" />
                                    </group>
                                    <group>
                                        <field name="description" />
                                    </group>
                                    <group>
                                        <field name="summary" />
                                    </group>
                                    <field name="topic_ids"
                                        context="{'default_course_id': id}">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle" />
                                            <field name="name" />
                                            <!-- <field name="course_id" invisible="1" /> -->
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="subjects" string="Subjects">
                                <group name="subject" string="Subjects">
                                    <field
                                        context="{'default_course_id': id}"
                                        name="subject_ids" nolabel="1" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_op_course_search" model="ir.ui.view">
            <field name="name">op.course.search</field>
            <field name="model">op.course</field>
            <field eval="8" name="priority" />
            <field name="arch" type="xml">
                <search string="Course">
                    <field name="name" />
                    <field name="code" />
                    <!-- <field name="section" /> -->
                    <!-- <field name="evaluation_type" /> <field name="parent_id" /> -->
                    <newline />
                    <group expand="0" string="Group By...">
                        <!-- <filter context="{'group_by':'evaluation_type'}" domain="[]" 
                            string="Evaluation Type" /> <filter context="{'group_by':'parent_id'}" domain="[]" string="Parent 
                            Course" /> -->
                    </group>
                </search>
            </field>
        </record>
        <record id="act_open_op_course_view" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.course</field>
<!--            <field name="view_type">form</field>-->
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_op_course_search" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <record id="act_open_op_course_view_form" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_op_course_view" />
            <field eval="20" name="sequence" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_course_form" />
        </record>
        <record id="act_open_op_course_view_tree" model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_op_course_view" />
            <field eval="10" name="sequence" />
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_course_tree" />
        </record>
    </data>
</odoo>
