<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_op_batch_tree" model="ir.ui.view">
            <field name="name">op.batch.tree</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Batch">
                    <field name="course_id" />
                    <field name="code" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="name" />
                </list>
            </field>
        </record>
        <record id="view_op_batch_form" model="ir.ui.view">
            <field name="name">op.batch.form</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Batch">
                    <header groups="openeducat_core.group_op_back_office"></header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button"
                                icon="fa-archive">
                                <field name="active" widget="boolean_button"
                                    options="{&quot;terminology&quot;: &quot;archive&quot;}" />
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="course_id" />
                                <field name="name" />
                                <field name="code" />
                            </group>
                            <group>
                                <field name="start_date" />
                                <field name="end_date" />
                            </group>

                        </group>
                        <notebook>
                            <page name="faculties" string="Faculties">
                                <field name="faculty_ids" options="{'no_create':True}" 
                                context="{'default_batch_id':id,'default_course_id': course_id,'from_batch': 1}"/>
                            </page>
                            <page name="students" string="Students">
                                <field name="register_ids" options="{'no_create':True}"
                                context="{'default_batch_id':id,'default_course_id': course_id,'from_batch': 1}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_op_batch_search" model="ir.ui.view">
            <field name="name">op.batch.search</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <search string="Batch">
                    <field name="code" />
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="course_id" />
                    <separator />
                    <group expand="0" string="Group By...">
                        <filter  string="Start Date" domain="[]" name="start_date"
                            context="{'group_by':'start_date'}" />
                        <filter  string="End Date" domain="[]" name="end_date"
                            context="{'group_by':'end_date'}" />
                        <filter string="Course" domain="[]" name="course"
                                context="{'group_by':'course_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="act_open_op_batch_view">
            <field name="name">Batches</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.batch</field>
<!--            <field name="view_type">form</field>-->
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_op_batch_search" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <record model="ir.actions.act_window.view" id="act_open_op_batch_view_form">
            <field name="act_window_id" ref="act_open_op_batch_view" />
            <field name="sequence" eval="20" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_batch_form" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_op_batch_view_tree">
            <field name="act_window_id" ref="act_open_op_batch_view" />
            <field name="sequence" eval="10" />
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_batch_tree" />
        </record>
    </data>
</odoo>
