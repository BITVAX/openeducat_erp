<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="kanban_view_student">
            <field name="name">Student Kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_employee_kanban">
                    <field name="id"/>
                    <field name="email" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <a type="open">
                                        <img
                                            t-att-src="kanban_image('op.student', 'image', record.id.raw_value)"
                                            class="oe_employee_picture" />
                                    </a>
                                </div>
                                <div class="oe_kanban_details">
                                    <h4>
                                        <a type="open">
                                            <field name="name" />
                                            <!-- <t t-if="record.middle_name.raw_value"> 
                                                <field name="middle_name" /> </t> <t t-if="record.lastname.raw_value"> <field name="lastname"
                                                /> </t> -->
                                        </a>
                                    </h4>
                                    <ul>
                                        <li t-if="record.contact_address.raw_value">
                                            Address:
                                            <field name="contact_address" />
                                        </li>
                                        <li t-if="record.phone.raw_value">
                                            Tel:
                                            <field name="phone" />
                                        </li>
                                        <li t-if="record.mobile.raw_value">
                                            Mobile:
                                            <field name="mobile" />
                                        </li>
                                        <li t-if="record.email.raw_value">
                                            <a t-attf-href="mailto:#{record.email.value}">
                                                <field name="email" />
                                            </a>
                                        </li>
                                        <li t-if="record.lang.raw_value">
                                            Language:
                                            <field name="lang" />
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_op_student_tree" model="ir.ui.view">
            <field name="name">op.student.tree</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Student">
                    <field name="title" />
                    <field name="firstname" />
                    <!-- <field name="middle_name" /> -->
                    <field name="lastname" />
                    <!-- <field name="blood_group" /> -->
                    <field name="emergency_contact" />
                    <field name="nationality" />
                    <field name="lang" />
                </list>
            </field>
        </record>
        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Student">
                    <header />
                    <sheet>
                        <div class="oe_button_box" name="button_box">
<!--                            <button name="toggle_active" type="object" class="oe_stat_button"-->
<!--                                icon="fa-archive">-->
<!--                                <field name="active" widget="boolean_button"-->
<!--                                    options="{&quot;terminology&quot;: &quot;archive&quot;}" />-->
<!--                            </button>-->
                        </div>
                        <div class="oe_title">
                            <field name="already_partner" />
                            <label string="Already Partner" for="already_partner"/>
                            <field name="partner_id" placeholder="Partner"
                                options="{'no_create_edit': True}"
                                required="already_partner"
                                invisible="not already_partner" />
                        </div>
                        <field name="name" invisible="1" />
                        <!-- La foto: en v12 era `image`, que en v18 pasó a ser
                             `image_1920` (delegado de res.partner). Al migrar se
                             comentó en vez de renombrarse, y por eso la ficha
                             salía sin foto. -->
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options="{'preview_image': 'image_128'}" />
                        <div class="oe_title">
                            <h3>
                                <field name="title" placeholder="Title" />
                            </h3>
                            <!-- Nombre y apellidos en la misma línea. En v12 esto
                                 era una <table> de una fila; el renderizador de v18
                                 no la trata como maquetación del título y rompía la
                                 tipografía. `d-flex` da el mismo resultado con los
                                 campos directamente dentro del h1, que es lo que el
                                 tema espera. El ancho se acota a mano porque v18 ya
                                 no tiene modo lectura: el título es siempre un
                                 <input>, y sin acotarlo cada uno se estira a media
                                 ficha y el apellido acaba a un palmo del nombre. Y sin
                                 `w-auto`: Bootstrap lo declara `width:auto!important`
                                 y el !important gana al estilo en línea, con lo que el
                                 ancho de abajo no llegaría a aplicarse. -->
                            <h1 class="d-flex gap-2">
                                <field name="firstname" required="1"
                                    style="width: 11rem" placeholder="First Name" />
                                <field name="lastname" placeholder="Last Name"
                                    style="width: 20rem" required="1" />
                            </h1>
                        </div>
                        <group name="personal_information" string="Personal Information">
                            <!-- v12 pintaba estos once campos con `col="4"`: dos pares
                                 etiqueta/valor por fila y a todo el ancho. En v18 el
                                 ancho sale de `12 * colspan / col_del_padre`, aquí
                                 12*4/2 = 24, y Bootstrap solo define hasta 12: la
                                 clase no existe, el navegador la ignora, el bloque se
                                 va a ancho completo y empuja la dirección abajo. Dos
                                 subgrupos dan la misma rejilla que v12 sin depender de
                                 colspan. El reparto respeta el orden por filas que
                                 tenía v12: email/NIF, teléfono/contacto de emergencia,
                                 idioma/fecha de nacimiento, nacionalidad/categoría,
                                 sexo/grupo sanguíneo. -->
                            <group name="personal_detail">
                                <field name="email" required="1" />
                                <field name="phone" />
                                <field name="lang" />
                                <field name="nationality" />
                                <field name="gender" />
                                <field name="visa_info" />
                            </group>
                            <group name="personal_detail_right">
                                <field name="vat" required="1" />
                                <field name="emergency_contact" context="{'show_address': 1}"
                                    options="{&quot;always_reload&quot;: True}" />
                                <field name="birth_date" />
                                <field name="category_id" />
                                <field name="blood_group" />
                            </group>
                        </group>
                        <!-- La dirección va en su propio bloque, debajo, como en v12. -->
                        <group name="address_block">
                            <group name="address">
                                <label for="street" string="Address" />
                                <div name="div_address">
                                    <field name="street" placeholder="Street..." />
                                    <field name="street2" placeholder="Street2" />
                                    <div class="address_format">
                                        <field name="zip_id"
                                            options="{'create_name_field': 'city', 'no_open': True, 'no_create': True}"
                                            placeholder="City completion" class="oe_edit_only" />
                                        <field name="city" placeholder="City"
                                            style="width: 40%" />
                                        <field name="state_id" class="oe_no_button"
                                            placeholder="State" style="width: 37%"
                                            options="{&quot;no_open&quot;: True,&quot;no_create&quot;:True}"
                                            domain="[['country_id','=',country_id]]" />
                                        <field name="zip" placeholder="ZIP" style="width: 20%" />
                                    </div>
                                    <field name="country_id" placeholder="Country"
                                        class="oe_no_button"
                                        options="{&quot;no_open&quot;: True,&quot;no_create&quot;:True}" />
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page name="educational" string="Educational">
                                <!-- El separador y la lista van sueltos en la página:
                                     dentro de un <group> el separador heredaba el
                                     mismo cálculo de colspan roto y partía la tabla
                                     por la mitad. -->
                                <separator string="Admission Details" />
                                <field name="course_detail_ids" nolabel="1"
                                    context="{'from_student':1,'default_student_id':id}" />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_op_student_search" model="ir.ui.view">
            <field name="name">op.student.search</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <search string="Student">
                    <field name="name" />
                    <field name="blood_group" />
                    <newline />
                    <group expand="0" string="Group By...">
                        <filter name="blood_group" string="Blood Group" domain="[]"
                            context="{'group_by':'blood_group'}" />
                        <filter name="nationality" string="Nationality" domain="[]"
                            context="{'group_by':'nationality'}" />
                        <filter name="language" string="Language" domain="[]"
                            context="{'group_by':'lang'}" />
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="act_open_op_student_view">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
<!--            <field name="view_type">form</field>-->
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_op_student_search" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help">
				<![CDATA[<p class="oe_view_nocontent_create">
                    Clic para agregar un estudiante en su directorio.
                </p>
                <p>
                    Odoo le ayuda a rastrear fácilmente toda la actividad relacionada a
                    un estudiante: discusiones, cursos,
                    documentos, etc.
                </p>]]>
            </field>
        </record>
        <record model="ir.actions.act_window.view" id="act_open_op_student_view_form">
            <field name="act_window_id" ref="act_open_op_student_view" />
            <field name="sequence" eval="20" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_student_form" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_op_student_view_tree">
            <field name="act_window_id" ref="act_open_op_student_view" />
            <field name="sequence" eval="10" />
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_student_tree" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_op_student_view_kanban">
            <field name="act_window_id" ref="act_open_op_student_view" />
            <field name="sequence" eval="5" />
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="kanban_view_student" />
        </record>
        <record id="view_op_student_course_tree" model="ir.ui.view">
            <field name="name">op.student.course.tree</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Course Details">
                    <field name="student_id" invisible="context.get('from_parent_student')" />
                    <field name="course_id" invisible="context.get('from_batch')" />
                    <field name="batch_id" invisible="context.get('from_batch')" />
                    <field name="roll_number" />
                    <field name="subject_ids" widget="many2many_tags" />
                </list>
            </field>
        </record>
        <record id="view_op_student_course_form" model="ir.ui.view">
            <field name="name">op.student.course.form</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Student">
                    <header />
                    <sheet>
                        <group>
                            <field name="student_id" invisible="context.get('from_parent_student')" />
                            <field name="course_id" />
                            <field name="batch_id" domain="[('course_id', '=', course_id)]" />
                            <field name="roll_number" />
                        </group>
                        <notebook>
                            <page string="Subjects">
                                <group string="Subjects">
                                    <field name="subject_ids" nolabel="1" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
